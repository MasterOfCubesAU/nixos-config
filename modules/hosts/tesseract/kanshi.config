output 'Acer Technologies XV345CUR V3 2439024892X00' {
  mode 3440x1440@180.000
  position 0,0
  alias $MIDDLE
}

output 'Acer Technologies ED270U P TKYSA0013W01' {
  mode 2560x1440@59.951
  position 3440,-850
  transform 270
  alias $RIGHT
}

output 'Lenovo Group Limited LEN D32q-20B 0x36435A43' {
  mode 2560x1440@59.951
  position 250,-1440
  transform 180
  alias $TOP
}

profile {
  output $MIDDLE enable
  output $TOP enable
  output $RIGHT enable
}

